# ==============================================================================
# KUBER CLOUD DEPLOYMENT ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AIVEN CLOUD MANAGED MYSQL (Free Tier - 1GB Storage)
# ------------------------------------------------------------------------------
# Format: mysql+aiomysql://<user>:<password>@<aiven-host>:<port>/<db_name>
MYSQL_MUMBAI_URL=mysql+aiomysql://avnadmin:your_password_here@mysql-kuber-aivencloud.com:12345/kuber_db_mumbai
MYSQL_DELHI_URL=mysql+aiomysql://avnadmin:your_password_here@mysql-kuber-aivencloud.com:12345/kuber_db_delhi

# ------------------------------------------------------------------------------
# 2. UPSTASH SERVERLESS REDIS (Free Tier - TLS Encrypted)
# ------------------------------------------------------------------------------
# Note: 'rediss://' protocol prefix enables TLS SSL encryption required by Upstash
REDIS_URL=rediss://default:your_upstash_redis_password@upstash-redis-instance.upstash.io:6379

# ------------------------------------------------------------------------------
# 3. UPSTASH QSTASH (Free Serverless HTTP Message Queue)
# ------------------------------------------------------------------------------
# Found under QStash tab in Upstash Console -> API Keys -> Current Signing Key / Bearer Token
QSTASH_TOKEN=eyJn...your_upstash_qstash_bearer_token_here
DISPATCH_WORKER_URL=https://kuber-dispatch-engine.onrender.com/dispatch/process

# ------------------------------------------------------------------------------
# 4. MICROSERVICE ENDPOINT ROUTING (Render Cloud URLs)
# ------------------------------------------------------------------------------
LOCATION_ENGINE_URL=https://kuber-location-engine.onrender.com
DISPATCH_ENGINE_URL=https://kuber-dispatch-engine.onrender.com
WEBSOCKET_HUB_URL=wss://kuber-websocket-hub.onrender.com
BILLING_ENGINE_URL=https://kuber-billing-engine.onrender.com
SURGE_ENGINE_URL=https://kuber-surge-engine.onrender.com
VERIFICATION_ENGINE_URL=https://kuber-verification-engine.onrender.com
